# ---------------------------------------------------------------------------
# JobFlow environment configuration. Copy to .env and fill in real values.
# NEVER commit a real .env. All secrets stay server-side only.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
APP_URL=http://localhost:3000

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Database (Postgres). The docker-compose file provisions this locally.
DATABASE_URL=postgresql://jobflow:jobflow@localhost:5432/jobflow?schema=public

# ---------------------------------------------------------------------------
# LLM provider. Choose one of: anthropic | bridge | mock
#   anthropic -> official Anthropic API (requires ANTHROPIC_API_KEY)
#   bridge    -> a self-hosted Claude bridge. NOTE: the bridge protocol is NOT
#               verified in this build. You MUST supply a real, documented
#               endpoint + request/response shape. See src/lib/llm/bridge.ts.
#   cli       -> real Claude via the local `claude` CLI (Claude Code login; no API key)
#   mock      -> deterministic local stub for development and tests. No network.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# Anthropic official API (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Claude bridge (used when LLM_PROVIDER=bridge). UNVERIFIED PROTOCOL - see docs.
BRIDGE_BASE_URL=
BRIDGE_API_KEY=

# ---------------------------------------------------------------------------
# File storage. "local" writes to a private directory outside the web root.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads

# Real job discovery provider:
#   none      = honest empty/not-connected state (default; never fake listings)
#   arbeitnow = real free keyless live job feed (latest-first; attribution shown)
#   demo      = clearly-labeled sample data on the real route too (opt-in)
JOBS_PROVIDER=none

# ---------------------------------------------------------------------------
# Billing. "dev" is an explicitly labeled development adapter that NEVER
# processes real payments. Use "stripe" only with real credentials.
# ---------------------------------------------------------------------------
BILLING_PROVIDER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=

# Extension pairing: origin allowed to connect the Chrome extension.
EXTENSION_ALLOWED_ORIGIN=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Public install link for end users. Set this to your published listing once the
# extension is live on the Chrome Web Store / Edge Add-ons / Firefox AMO. When set,
# the Extension settings page shows a one-click "Add to browser" button; when unset,
# it shows the developer "load unpacked" flow. See docs/PUBLISH_EXTENSION.md.
# EXTENSION_WEBSTORE_URL=https://chromewebstore.google.com/detail/YOUR_EXTENSION_ID

# LLM policy (optional; sensible defaults)
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_RATE_LIMIT_PER_MIN=20
