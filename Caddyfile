# Automatic HTTPS for the domain (Let's Encrypt, provisioned once DNS points here).
vaylo.co.in, www.vaylo.co.in {
	encode gzip
	reverse_proxy app:3000
}

# Plain-HTTP access by IP, useful for testing before DNS propagates.
# (Caddy does not attempt a certificate for a bare IP over http://.)
# Strip the HTTPS-forcing headers here ONLY so the page renders over plain
# HTTP on the IP. The domain vhost above keeps full security headers.
http://13.238.23.72 {
	reverse_proxy app:3000 {
		header_down -Strict-Transport-Security
		header_down >Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:"
	}
}
