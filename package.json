{
  "name": "jobflow",
  "version": "0.1.0",
  "private": true,
  "description": "JobFlow - job application automation (foundation build)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "ext:build": "node extension/build.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.68.0",
    "@aws-sdk/client-bedrock-runtime": "^3.709.0",
    "@prisma/client": "6.17.0",
    "bcryptjs": "2.4.3",
    "mammoth": "1.8.0",
    "next": "16.4.2",
    "pino": "9.5.0",
    "playwright": "^1.64.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "stripe": "^17.5.0",
    "superjson": "2.2.2",
    "unpdf": "0.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "2.4.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.10.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^25.0.1",
    "pino-pretty": "13.0.0",
    "postcss": "8.4.49",
    "prisma": "6.17.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "2.1.8"
  }
}
